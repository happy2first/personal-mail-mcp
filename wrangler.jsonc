{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-mail-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROTON_SESSIONS",
        "class_name": "ProtonSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProtonSession"
      ]
    }
  ],
  "keep_vars": true
}
