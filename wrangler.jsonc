{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-mail-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "TEAM_DOMAIN": "https://liao8top.cloudflareaccess.com"
  }
}
