# Cloudflare Access
TEAM_DOMAIN=https://example.cloudflareaccess.com
POLICY_AUD=replace-with-cloudflare-access-application-aud

# Enabled accounts
MAIL_ACCOUNTS=qq,163main,gmail,proton1,proton2

# QQ Mail
MAIL_QQ_PROVIDER=qq
MAIL_QQ_LABEL=QQ Mail
MAIL_QQ_EMAIL=your-address@example.com
MAIL_QQ_CREDENTIAL=replace-with-qq-authorization-code

# 163 Mail
MAIL_163MAIN_PROVIDER=163
MAIL_163MAIN_LABEL=163 Mail
MAIL_163MAIN_EMAIL=your-address@example.com
MAIL_163MAIN_CREDENTIAL=replace-with-163-client-authorization-code

# Gmail
MAIL_GMAIL_PROVIDER=gmail
MAIL_GMAIL_LABEL=Gmail
MAIL_GMAIL_EMAIL=your-address@gmail.com
MAIL_GMAIL_CREDENTIAL=replace-with-google-app-password

# Proton Mail account 1 (EMAIL/CREDENTIAL should be Cloudflare Secrets in production)
MAIL_PROTON1_PROVIDER=proton
MAIL_PROTON1_LABEL=Proton 1
MAIL_PROTON1_EMAIL=your-address@proton.me
MAIL_PROTON1_CREDENTIAL=replace-with-proton-password
# Only for legacy/two-password Proton accounts:
# MAIL_PROTON1_MAILBOX_PASSWORD=replace-with-mailbox-password

# Proton Mail account 2
MAIL_PROTON2_PROVIDER=proton
MAIL_PROTON2_LABEL=Proton 2
MAIL_PROTON2_EMAIL=your-second-address@proton.me
MAIL_PROTON2_CREDENTIAL=replace-with-proton-password
# MAIL_PROTON2_MAILBOX_PASSWORD=replace-with-mailbox-password

# REQUIRED for durable Proton sessions. Configure as a Cloudflare Secret.
# Generate a random value, e.g. `openssl rand -base64 32`.
PROTON_SESSION_KEY=replace-with-random-session-encryption-secret

# REQUIRED for clickable Proton CAPTCHA / human-verification links.
# Use the public origin of this Worker (custom domain recommended), no trailing slash.
PROTON_VERIFY_BASE_URL=https://mail.mcp.example.com

# Optional Proton compatibility overrides; normally leave unset.
# The default app version is macos-bridge@3.24.1. AppVersion spoofing is NOT relied upon for risk control.
# PROTON_APP_VERSION=macos-bridge@3.24.1
# PROTON_API_BASE=https://mail.proton.me/api
